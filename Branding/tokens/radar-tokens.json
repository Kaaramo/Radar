{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "RADAR Design Tokens — Radar Editorial (navy + royal blue, McKinsey-inspired). W3C Design Tokens Format Module (draft). Compatible Style Dictionary, Tokens Studio for Figma, Cobalt UI.",

  "color": {
    "$type": "color",

    "navy": {
      "$description": "Surfaces dark — palette dominante (60% du systeme)",
      "1000": { "$value": "#051C2C", "$description": "Background dominant" },
      "900": {
        "$value": "#0A2540",
        "$description": "Surface elevee — sidebar, header"
      },
      "800": {
        "$value": "#133553",
        "$description": "Cards, modals, blocs de donnees"
      },
      "700": {
        "$value": "#1F4868",
        "$description": "Bordures sur fond dark, separateurs"
      }
    },

    "royal": {
      "$description": "Brand primary — Royal Blue, accent strict (10% max d'un ecran)",
      "default": {
        "$value": "#2251FF",
        "$description": "PRIMARY — CTA, liens, hero KPI, focus"
      },
      "light": {
        "$value": "#4F73FF",
        "$description": "Hover button, badges actifs"
      },
      "dark": {
        "$value": "#1A3FCC",
        "$description": "Pressed state, charts comparatifs"
      },
      "soft": {
        "$value": "#E5EBFF",
        "$description": "Backgrounds informatifs (mode light)"
      }
    },

    "neutral": {
      "$description": "Texte et neutres calibres pour lecture longue dark + impression claire",
      "bone": {
        "$value": "#F5F1EB",
        "$description": "Texte principal sur fond navy"
      },
      "cream": {
        "$value": "#FAF8F3",
        "$description": "Surface light alternative (V2)"
      },
      "ink": {
        "$value": "#1A1A1A",
        "$description": "Texte principal sur fond clair"
      },
      "ink-soft": {
        "$value": "#4A4A4A",
        "$description": "Sous-titres en mode light"
      },
      "muted": {
        "$value": "#8FA3B8",
        "$description": "Metadonnees sur fond navy"
      },
      "muted-soft": {
        "$value": "#6B7280",
        "$description": "Captions, footers, labels axes"
      }
    },

    "border": {
      "default": {
        "$value": "#1F4868",
        "$description": "Bordures par defaut — = navy.700"
      },
      "strong": {
        "$value": "#2251FF",
        "$description": "Focus rings (2px) — = royal"
      }
    },

    "semantic": {
      "$description": "Couleurs de systeme — sobres, sans neons satures",
      "success": {
        "$value": "#0F8F65",
        "$description": "Confirmation, source recoupee"
      },
      "warning": {
        "$value": "#C77700",
        "$description": "Alerte non-bloquante, source a verifier"
      },
      "error": {
        "$value": "#B42318",
        "$description": "Echec critique, source rejetee"
      },
      "info": {
        "$value": "#2251FF",
        "$description": "Information neutre, callout — = royal"
      }
    },

    "pestel": {
      "$description": "Couleurs metier des 6 dimensions PESTEL — calibrees McKinsey-fit",
      "political": { "$value": "#B42318" },
      "economic": { "$value": "#C77700" },
      "social": { "$value": "#4A1D6E" },
      "technological": { "$value": "#2251FF" },
      "environmental": { "$value": "#0F8F65" },
      "legal": { "$value": "#1A3FCC" }
    },

    "swot": {
      "$description": "Couleurs metier des 4 cadrans SWOT — alignees sur semantiques",
      "strengths": { "$value": "#2251FF", "$description": "Forces — royal" },
      "weaknesses": {
        "$value": "#C77700",
        "$description": "Faiblesses — warning"
      },
      "opportunities": {
        "$value": "#0F8F65",
        "$description": "Opportunites — success"
      },
      "threats": { "$value": "#B42318", "$description": "Menaces — error" }
    },

    "category": {
      "$description": "Categories de mouvement (composant MovementRow)",
      "pricing": { "$value": "#C77700" },
      "product": { "$value": "#2251FF" },
      "hiring": { "$value": "#4A1D6E" },
      "funding": { "$value": "#0F8F65" },
      "communication": { "$value": "#8FA3B8" }
    }
  },

  "spacing": {
    "$type": "dimension",
    "$description": "Systeme 4px — toute valeur multiple de 4",
    "1": { "$value": "0.25rem" },
    "2": { "$value": "0.5rem" },
    "3": { "$value": "0.75rem" },
    "4": { "$value": "1rem" },
    "5": { "$value": "1.5rem" },
    "6": { "$value": "2rem" },
    "7": { "$value": "3rem" },
    "8": { "$value": "4rem" },
    "9": { "$value": "6rem" },
    "10": { "$value": "8rem" }
  },

  "radius": {
    "$type": "dimension",
    "sm": { "$value": "4px" },
    "md": { "$value": "6px", "$description": "Radius par defaut — editorial" },
    "lg": { "$value": "8px" },
    "pill": { "$value": "9999px" }
  },

  "font": {
    "family": {
      "$type": "fontFamily",
      "display": { "$value": ["Fraunces", "Times New Roman", "serif"] },
      "sans": {
        "$value": ["Inter", "-apple-system", "Segoe UI", "sans-serif"]
      },
      "mono": { "$value": ["JetBrains Mono", "Menlo", "Consolas", "monospace"] }
    },
    "size": {
      "$type": "dimension",
      "display": { "$value": "4rem" },
      "h1": { "$value": "2.5rem" },
      "h2": { "$value": "1.75rem" },
      "h3": { "$value": "1.25rem" },
      "body-l": { "$value": "1rem" },
      "body": { "$value": "0.875rem" },
      "body-s": { "$value": "0.75rem" },
      "eyebrow": { "$value": "0.6875rem" },
      "mono": { "$value": "0.8125rem" }
    },
    "weight": {
      "$type": "fontWeight",
      "light": { "$value": 300 },
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    }
  },

  "layout": {
    "$type": "dimension",
    "sidebar-width": { "$value": "264px" },
    "header-height": { "$value": "64px" },
    "content-max": { "$value": "1440px" }
  },

  "duration": {
    "$type": "duration",
    "fast": { "$value": "150ms" },
    "base": { "$value": "200ms" },
    "slow": { "$value": "300ms" }
  },

  "easing": {
    "$type": "cubicBezier",
    "out": { "$value": [0.16, 1.0, 0.3, 1.0] }
  },

  "shadow": {
    "$type": "shadow",
    "$description": "Shadows minimalistes — sobriete editoriale",
    "sm": {
      "$value": {
        "color": "rgba(0,0,0,0.20)",
        "offsetX": "0px",
        "offsetY": "1px",
        "blur": "2px",
        "spread": "0px"
      }
    },
    "md": {
      "$value": {
        "color": "rgba(0,0,0,0.25)",
        "offsetX": "0px",
        "offsetY": "2px",
        "blur": "8px",
        "spread": "0px"
      }
    },
    "lg": {
      "$value": {
        "color": "rgba(0,0,0,0.30)",
        "offsetX": "0px",
        "offsetY": "4px",
        "blur": "16px",
        "spread": "0px"
      }
    }
  }
}
