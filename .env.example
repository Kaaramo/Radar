# =====================================================================
# RADAR - Modele de configuration. Copier en `.env` puis renseigner.
#   cp .env.example .env
# La stack Docker est auto-suffisante : `docker compose up -d --build`
# cree la base locale + applique le schema (service db-migrate) tout seul.
# =====================================================================

# --- Base de donnees ---
# Par DEFAUT : Postgres LOCAL (conteneur Docker de la stack).
# Sert aux outils cote HOTE (ex: prisma) -> hote = localhost.
# Les conteneurs utilisent le nom de service Docker "postgres" defini EN DUR
# dans docker-compose.yml : la stack tourne meme si cette variable change.
# Le schema est applique automatiquement par Postgres au 1er demarrage
# (infra/docker/stack-complet/initdb/01-init.sql).
DATABASE_URL="postgresql://radar:radar@localhost:5432/radar?schema=public"

# Base cloud (Neon, etc.) : optionnelle, conservee pour bascule future. NON utilisee par defaut.
DATABASE_NEON=""

# --- apps/web (Next.js) ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Better Auth (apps/web) ---
# Secret OBLIGATOIRE (genere un aleatoire : openssl rand -hex 32).
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# --- Google OAuth (apps/web) ---
# Placeholders OK : la connexion email/mot de passe fonctionne sans eux.
# Renseigner de vrais identifiants pour activer "Se connecter avec Google".
GOOGLE_CLIENT_ID="placeholder-google-client-id"
GOOGLE_CLIENT_SECRET="placeholder-google-client-secret"

# --- OpenAI (fallback) ---
OPENAI_API_KEY=""

# --- OpenClaw (moteur agent) ---
DEEPSEEK_API_KEY=""
TAVILY_API_KEY=""
OPENCLAW_INTERNAL_SECRET="change-me"
